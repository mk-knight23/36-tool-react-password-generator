# MK VaultPass — Environment Configuration
# Copy to `.env.local` and fill in as needed. Every variable is optional:
# the deterministic core product works with none of them set.

# ============================================================
# Site
# ============================================================
# Drives canonical URLs / OG / sitemap. Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://vaultpass.mkazi.live

# ============================================================
# Analytics (GTM) — consent-gated, disabled by default
# ============================================================
# Leave unset to fully disable analytics (no script loads, track() is a no-op).
# Also disabled automatically when NODE_ENV !== "production".
NEXT_PUBLIC_GTM_ID=

# ============================================================
# AdSense — prepared but disabled (STANDARDS §7)
# ============================================================
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ============================================================
# AI route (POST /api/ai/explain) — OPTIONAL
# ============================================================
# The core generator works with NONE of these set. When no gateway credential
# is available, the route returns 503 `ai_unavailable` and the UI shows the
# deterministic built-in explanation, clearly labeled as non-AI.
#
# Auth resolves in this order (first available wins):
#   1. A user's own key sent per-request as the `x-byok-key` header (BYOK).
#      Never logged, never stored server-side, set from Settings on the client.
#   2. AI_GATEWAY_API_KEY below (server env), for self-hosting / local dev.
#   3. Vercel OIDC (VERCEL_OIDC_TOKEN), injected automatically on Vercel deploys
#      — nothing to set here in that case.
AI_GATEWAY_API_KEY=
#
# Model slugs are config, not code (STANDARDS §10). AI_MODEL handles most
# topics; AI_MODEL_QUALITY is used for the policy-explanation topic.
AI_MODEL=anthropic/claude-haiku-4.5
AI_MODEL_QUALITY=anthropic/claude-sonnet-4-5
